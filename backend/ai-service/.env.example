# AI Service Environment Configuration Template
# Copy this file to `.env` and fill in your API keys and configuration credentials.

# -----------------------------------------------------------------------------
# Google Gemini API Key (Used for Vector DB Embeddings & Reviewer Orchestration)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Groq API Key (Used for fast parallel worker node diff hunk analysis)
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# Neo4j Graph Database Credentials (Vectorless Graph Knowledge Base)
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=s3cureP@ssword
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# ChromaDB Vector Persistence Directory
# -----------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db
